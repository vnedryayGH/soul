@startuml
!theme plain
title Рождение квантов — процесс
participant "Inbound Message" as msg
participant "Processor" as proc
participant "Extractor" as ext
participant "LLM Proxy" as aux
participant "DB" as db
participant "AGE Graph" as age
msg -> proc: Новое сообщение/событие
proc -> ext: Извлечь эмоции/ключевые/метаданные
ext -> aux: LLM запрос (единый контракт)
aux -> ext: Ответ JSON
ext -> proc: Структурированный результат
proc -> db: Persist message + quant(s)
proc -> age: Upsert nodes/edges (semantic)
@enduml