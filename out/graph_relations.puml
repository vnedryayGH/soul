@startuml
!theme plain
title Графовые связи — сущности и отношения
component "Node: User\nvertex" as n_user
component "Node: Message\nvertex" as n_msg
component "Node: Quant\nvertex" as n_quant
component "Edge: AUTHORED\nUser -> Message" as e_authored
component "Edge: HAS_QUANT\nMessage -> Quant" as e_has_quant
component "Edge: REL\nQuant -> Quant (semantic)" as e_rel
component "Properties\nweights, relation_type, ts" as props
n_user --> n_msg : AUTHORED — сообщение создано пользователем
n_msg --> n_quant : HAS_QUANT — сообщение порождает кванты
n_quant --> n_quant : REL — семантическая связь (COALESCE(connection_type,'semantic'))
e_rel --> props : weight — сила связи; ts — время
@enduml