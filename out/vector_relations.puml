@startuml
!theme plain
title Векторные связи — эмбеддинги и сходство
component "Embeddings Store\nPG/pgvector or external" as vec_store
component "Quant Embeddings\nvector(d)" as quant_emb
component "Message Embeddings\nvector(d)" as msg_emb
component "Similarity Search\ncosine/L2/IP" as sim
component "Processor\nindex/update/search" as proc
proc --> vec_store : upsert vectors
proc --> sim : query topK
sim --> quant_emb : nearest neighbors (quants)
sim --> msg_emb : nearest neighbors (messages)
@enduml