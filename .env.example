# Пример конфигурации для клиента провайдера модели
# Скопируйте этот файл в .env и заполните своими значениями

# =============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ ПОДКЛЮЧЕНИЯ
# =============================================================================

# Основной endpoint провайдера модели
MODEL_PROVIDER_PRIMARY_ENDPOINT=https://api.openai.com

# Резервные endpoints (JSON массив строк)
MODEL_PROVIDER_FALLBACK_ENDPOINTS=["https://api.anthropic.com", "https://api.cohere.ai"]

# API ключ для аутентификации (ОБЯЗАТЕЛЬНО!)
MODEL_PROVIDER_API_KEY=your-api-key-here

# =============================================================================
# НАСТРОЙКИ ТАЙМАУТОВ И ПОВТОРНЫХ ПОПЫТОК
# =============================================================================

# Таймаут запроса в секундах
MODEL_PROVIDER_TIMEOUT=30.0

# Максимальное количество повторных попыток
MODEL_PROVIDER_MAX_RETRIES=5

# Начальная задержка между попытками (секунды)
MODEL_PROVIDER_RETRY_DELAY=1.0

# Максимальная задержка между попытками (секунды)
MODEL_PROVIDER_MAX_RETRY_DELAY=60.0

# Коэффициент увеличения задержки (экспоненциальный backoff)
MODEL_PROVIDER_BACKOFF_FACTOR=2.0

# =============================================================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# =============================================================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Формат логирования
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# НАСТРОЙКИ МОДЕЛИ ПО УМОЛЧАНИЮ
# =============================================================================

# Модель по умолчанию
MODEL_PROVIDER_DEFAULT_MODEL=gpt-3.5-turbo

# Температура по умолчанию (0.0 - 2.0)
MODEL_PROVIDER_DEFAULT_TEMPERATURE=0.7

# Максимальное количество токенов по умолчанию
MODEL_PROVIDER_DEFAULT_MAX_TOKENS=1000

# =============================================================================
# НАСТРОЙКИ МОНИТОРИНГА И ДИАГНОСТИКИ
# =============================================================================

# Включить сбор метрик (true/false)
MODEL_PROVIDER_ENABLE_METRICS=true

# Интервал проверки здоровья в секундах
MODEL_PROVIDER_HEALTH_CHECK_INTERVAL=60.0

# =============================================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# =============================================================================

# Максимальный размер истории метрик
METRICS_MAX_HISTORY_SIZE=1000

# Максимальное количество алертов в памяти
ALERTS_MAX_COUNT=1000

# Интервал мониторинга системы в секундах
SYSTEM_MONITOR_INTERVAL=30.0