server {
    listen 80;
    server_name mini.soulpulse.art;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mini.soulpulse.art;

    # SSL (пути на проде реальны)
    ssl_certificate /etc/letsencrypt/live/mini.soulpulse.art/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mini.soulpulse.art/privkey.pem;

    root /var/www/soulpulse/frontend;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Telegram webhook
    location /webhook/telegram {
        proxy_pass http://127.0.0.1:8000/webhook/telegram;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    access_log /var/log/soulpulse/nginx_access.log;
    error_log  /var/log/soulpulse/nginx_error.log;
}
